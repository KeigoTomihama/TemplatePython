{
    "name": "Python Dev Container",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "workspaceFolder": "/Git/Python",
    "workspaceMount": "target=${containerWorkspaceFolder}/.venv,type=volume",
    "mounts": [
        "source=.,target=${containerWorkspaceFolder},type=bind"
    ],
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "remoteEnv": {
        "PYTHONPATH": "${containerWorkspaceFolder}:$PYTHONPATH"
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "username": "vscode"
        },
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {
            "version": "latest",
            "installAsUser": "vscode"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.autopep8",
                "ms-python.black-formatter",
                "ms-vscode-remote.remote-containers"
            ]
        },
        "settings": {
            "extensions.verifySignature": true,
            "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
            "[python]": {
                "editor.defaultFormatter": "ms-python.black-formatter",
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                }
            }
        }
    },
    "postCreateCommand": "cd ${containerWorkspaceFolder} && sudo chown -R vscode:vscode .venv",
    "postAttachCommand": "uv sync"
}